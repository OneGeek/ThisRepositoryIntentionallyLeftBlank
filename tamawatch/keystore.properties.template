# Release signing config for TamaWatch.
#
# 1. Copy this file to `keystore.properties` (which is git-ignored — never commit
#    it or your keystore).
# 2. Create a keystore if you don't have one:
#      keytool -genkeypair -v -keystore tamawatch-release.jks \
#        -alias tamawatch -keyalg RSA -keysize 2048 -validity 10000
# 3. Fill in the values below. `storeFile` is resolved relative to the project
#    root (this directory), so a bare filename works if the keystore lives here.
#
# With keystore.properties present, `./gradlew :app:assembleRelease` produces a
# signed, sideloadable APK; `./gradlew :app:bundleRelease` produces a signed AAB
# for the Play Console.

storeFile=tamawatch-release.jks
storePassword=CHANGE_ME
keyAlias=tamawatch
keyPassword=CHANGE_ME
