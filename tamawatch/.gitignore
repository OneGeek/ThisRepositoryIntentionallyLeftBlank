.gradle/
build/
app/build/

# Local SDK location (machine-specific)
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Python (asset generators)
__pycache__/
*.pyc

# Keystores / signing (never commit secrets)
*.jks
*.keystore
keystore.properties
